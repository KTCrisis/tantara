---
// La vignette des États, seule des six à ne rien inventer.
//
// Les cinq autres portes montrent des feuilles de spécimen de synthèse. Celle-ci
// est tracée depuis les données du site : le contour vient de
// public/madagascar.geojson, les foyers du barycentre des points géographiques
// portés par les assertions rattachées à chaque royaume. Ajouter une assertion
// située déplace un foyer, personne n'a de coordonnée à tenir.
//
// L'habillage est celui d'une carte ancienne, mais aucun de ses éléments ne
// ment : le cadre et le grain sont de l'ornement, le graticule marque de vrais
// degrés, le lavis côtier est une convention de gravure. Pas de toponyme
// inventé, pas de rose des vents fantaisiste, et pas de frontières, puisque
// personne ne sait où elles passaient.
import { getCollection } from 'astro:content';
// Vite ne traite pas .geojson comme du JSON : on le lit brut et on l'analyse.
import brut from '../../public/madagascar.geojson?raw';

const contour: [number, number][] = JSON.parse(brut).features[0].geometry.coordinates[0];

const claims = await getCollection('claims');
const entities = await getCollection('entities');
const royaumes = entities.filter((e) => e.data.kind === 'royaume');

const lngs = contour.map((p) => p[0]);
const lats = contour.map((p) => p[1]);
const [x0, x1] = [Math.min(...lngs) - 1.1, Math.max(...lngs) + 1.1];
const [y0, y1] = [Math.min(...lats) - 1.1, Math.max(...lats) + 1.1];
const W = 100;
const H = (W * (y1 - y0)) / (x1 - x0);
const px = (lng: number) => ((lng - x0) / (x1 - x0)) * W;
const py = (lat: number) => H - ((lat - y0) / (y1 - y0)) * H;

const trace = contour.map((p, i) => `${i ? 'L' : 'M'}${px(p[0]).toFixed(2)} ${py(p[1]).toFixed(2)}`).join(' ') + ' Z';

// Graticule aux degrés entiers : ce sont de vraies coordonnées, pas un décor.
const meridiens: number[] = [];
for (let l = Math.ceil(x0); l <= Math.floor(x1); l += 2) meridiens.push(px(l));
const paralleles: number[] = [];
for (let l = Math.ceil(y0); l <= Math.floor(y1); l += 2) paralleles.push(py(l));

const foyers = royaumes.map((r) => {
  const pts = claims
    .filter((c) => (c.data.scope ?? []).some((s: { id: string }) => s.id === r.id))
    .map((c) => c.data.geo)
    .filter(Boolean) as { lat: number; lng: number }[];
  if (!pts.length) return null;
  const lat = pts.reduce((a, p) => a + p.lat, 0) / pts.length;
  const lng = pts.reduce((a, p) => a + p.lng, 0) / pts.length;
  return { nom: r.data.nom as string, x: px(lng), y: py(lat) };
}).filter(Boolean) as { nom: string; x: number; y: number }[];

const uid = 'cr';
---
<svg viewBox={`0 0 ${W} ${H.toFixed(2)}`} class="carte-royaumes"
     role="img" aria-label={`Carte de Madagascar tracée depuis les données du site, ${foyers.length} foyers de royaumes marqués sans frontières.`}>
  <defs>
    {/* Grain de papier : bruit très faible, pour que le fond cesse d'être plat. */}
    <filter id={`${uid}-grain`} x="0" y="0" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="3" seed="7" result="n" />
      <feColorMatrix in="n" type="saturate" values="0" result="g" />
      <feComponentTransfer in="g" result="a"><feFuncA type="linear" slope="0.055" /></feComponentTransfer>
      <feComposite in="a" in2="SourceGraphic" operator="over" />
    </filter>
    {/* Lavis côtier : la convention de gravure qui épaissit la mer contre la
        terre. Un flou sur le trait suffit à l'imiter. */}
    <filter id={`${uid}-lavis`} x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="1.1" />
    </filter>
  </defs>

  <rect width={W} height={H} fill="#efe6d2" />
  <rect width={W} height={H} filter={`url(#${uid}-grain)`} fill="#efe6d2" />

  <g stroke="#a08a63" stroke-width="0.25" opacity="0.35">
    {meridiens.map((x) => <line x1={x} y1="0" x2={x} y2={H} />)}
    {paralleles.map((y) => <line x1="0" y1={y} x2={W} y2={y} />)}
  </g>

  <path d={trace} fill="none" stroke="#7d6a4a" stroke-width="2.6"
        opacity="0.45" filter={`url(#${uid}-lavis)`} />
  <path d={trace} fill="#f6efdd" />
  <path d={trace} fill="none" stroke="#4a3c28" stroke-width="0.7" stroke-linejoin="round" />

  {/* Les foyers en terre rouge plutôt qu'à la couleur du statut : la barre du
      dessous porte déjà cette information, et le violet jurerait sur le papier. */}
  {foyers.map((f) => (
    <g>
      <circle cx={f.x} cy={f.y} r="4.6" fill="#a8492f" opacity="0.14" />
      <circle cx={f.x} cy={f.y} r="1.35" fill="#8a3a23" opacity="0.9">
        <title>{f.nom}</title>
      </circle>
    </g>
  ))}

  <rect x="1.2" y="1.2" width={W - 2.4} height={H - 2.4} fill="none" stroke="#4a3c28" stroke-width="0.7" />
  <rect x="2.6" y="2.6" width={W - 5.2} height={H - 5.2} fill="none" stroke="#4a3c28" stroke-width="0.3" />
</svg>

<style>
  .carte-royaumes {
    display: block; max-height: 100%; max-width: 100%;
    width: auto; height: auto;
  }
</style>
