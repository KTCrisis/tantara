---
// Où se parlent les langues du sous-groupe auquel le malgache appartient.
//
// L'échelle est régionale, celle du bassin de la Barito : la carte de la traversée, plus
// bas sur la page, tient déjà l'échelle de l'océan. Ce qui se voit ici et qu'aucune carte
// large ne montrerait, c'est l'exiguïté du foyer. Trois langues voisines, quelques
// dizaines de kilomètres entre elles, et l'une d'elles a un rameau à sept mille cinq
// cents kilomètres.
//
// Coordonnées prises dans Glottolog. Quatre langues du groupe n'y sont pas localisées et
// ne sont donc pas placées : on ne met pas un point qu'on n'a pas. La carte ne trace
// aucun itinéraire, la route de la traversée étant un point débattu.

const LANGUES = [
  { nom: "ma'anyan", at: [-2.1239, 115.092], cible: true,
    note: 'le plus proche parent connu du malgache' },
  { nom: 'paku', at: [-1.9063, 115.087], cible: false, note: '' },
  { nom: 'dusun witu', at: [-1.5741, 114.979], cible: false, note: '' },
];
const payload = JSON.stringify({ langues: LANGUES });
---
<div class="map-wrap">
  <div class="map-barito" data-map={payload}
       aria-label="Carte du sud-est de Bornéo : trois langues du sous-groupe barito du sud-est, dont le ma'anyan, le plus proche parent connu du malgache."></div>
  <div class="map-legend">
    <span style="color:#8a3a23">ma'anyan, le plus proche parent connu</span>
    <span style="color:var(--ink-2)">langues du barito du sud-est · positions Glottolog · fond OpenStreetMap</span>
  </div>
</div>

<figcaption class="cap">
  <span class="quoi">
    Le malgache n'est pas seulement apparenté à ces langues : la classification de
    référence le range dans leur sous-groupe, le barito du sud-est, dont le ma'anyan est
    le membre le plus proche. Une même branche, dont les rameaux sont séparés par sept
    mille cinq cents kilomètres d'océan.
  </span>
  <span class="prov">
    Positions d'après Glottolog ; quatre autres langues du groupe n'y sont pas localisées
    et ne figurent donc pas ici. Aucun itinéraire n'est tracé : la route de la traversée
    est un point débattu, exposé plus bas sur cette page.
  </span>
</figcaption>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  for (const el of document.querySelectorAll('.map-barito')) {
    const { langues } = JSON.parse(el.dataset.map);
    const map = L.map(el, { scrollWheelZoom: false, zoomSnap: 0.5 });
    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: 'abcd',
      maxZoom: 11,
    }).addTo(map);
    map.fitBounds([[-0.4, 113.4], [-3.4, 116.6]]);

    for (const l of langues) {
      const col = l.cible ? '#8a3a23' : '#4a443a';
      if (l.cible) {
        L.circle(l.at, { radius: 34000, color: col, weight: 1, fill: false, opacity: 0.5 }).addTo(map);
      }
      L.circleMarker(l.at, {
        radius: l.cible ? 7 : 5, color: '#fff', weight: 1.5,
        fillColor: col, fillOpacity: 1,
      }).addTo(map).bindPopup(`<strong>${l.nom}</strong>${l.note ? '<br>' + l.note : ''}`);
      L.marker(l.at, {
        icon: L.divIcon({ className: 'barito-lab', html: `<span class="${l.cible ? 'cible' : ''}">${l.nom}</span>`,
                          iconSize: [90, 14], iconAnchor: [-10, 7] }),
      }).addTo(map);
    }
  }
</script>

<style is:global>
  .map-barito { height: 380px; border-radius: 3px; z-index: 0; }
  .map-barito .leaflet-tile { filter: sepia(0.22) saturate(0.85); }
  .map-barito .leaflet-popup-content { font-family: var(--sans); font-size: 0.8rem; line-height: 1.45; }
  .barito-lab span { font-family: var(--sans); font-size: 0.72rem; color: #4a443a;
                     text-shadow: 0 0 3px #fff, 0 0 3px #fff, 0 0 3px #fff; white-space: nowrap; }
  .barito-lab span.cible { color: #8a3a23; font-weight: 600; font-size: 0.8rem; }
  .cap { display: flex; flex-direction: column; gap: .15rem; margin-top: .6rem;
         font-family: var(--sans); font-size: .78rem; line-height: 1.55; color: var(--ink-2); }
  .cap .quoi { color: var(--ink); }
  .cap .prov { font-size: .72rem; opacity: .85; }
</style>
