---
// Où se parlent les langues du sous-groupe barito du sud-est.
//
// La figure ne montre pas une ressemblance entre deux langues éloignées : elle montre
// que la classification de référence range le malgache DANS le même sous-groupe que le
// ma'anyan et ses voisins de Bornéo. Ce ne sont pas des cousins lointains rapprochés
// après coup, c'est une seule branche dont les rameaux sont séparés par sept mille
// kilomètres d'océan.
//
// Coordonnées réelles, prises dans Glottolog. Les quatre langues du groupe que Glottolog
// ne localise pas (Samihim, Sihong, Dusun Balangan, Dusun Pepas) ne sont pas dessinées :
// on ne place pas un point qu'on n'a pas. Le trait entre les deux foyers ne figure aucun
// itinéraire ; la route de la traversée est un point débattu, exposé plus haut.

const BORNEO = [
  { nom: "Ma'anyan", lat: -2.1239, lng: 115.092, cible: true },
  { nom: 'Paku', lat: -1.9063, lng: 115.087, cible: false },
  { nom: 'Dusun Witu', lat: -1.5741, lng: 114.979, cible: false },
];
const MADA = { nom: 'malgache', lat: -19.5907, lng: 47.1211 };

// Projection équirectangulaire sur la fenêtre utile de l'océan Indien.
const LNG0 = 40, LNG1 = 122, LAT0 = 10, LAT1 = -28;
const W = 100, H = 46;
const px = (lng: number) => 4 + ((lng - LNG0) / (LNG1 - LNG0)) * (W - 8);
const py = (lat: number) => 4 + ((LAT0 - lat) / (LAT0 - LAT1)) * (H - 8);
const uid = 'cb';
---
<figure class="barito">
  <svg viewBox={`0 0 ${W} ${H}`} role="img"
       aria-label="Carte de l'océan Indien : trois langues du sous-groupe barito du sud-est situées au sud-est de Bornéo, dont le ma'anyan, et le malgache à Madagascar, séparés par environ sept mille cinq cents kilomètres.">
    <defs>
      <filter id={`${uid}-grain`} x="0" y="0" width="100%" height="100%">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="3" seed="6" result="n" />
        <feColorMatrix in="n" type="saturate" values="0" result="g" />
        <feComponentTransfer in="g" result="a"><feFuncA type="linear" slope="0.05" /></feComponentTransfer>
        <feComposite in="a" in2="SourceGraphic" operator="over" />
      </filter>
    </defs>
    <rect width={W} height={H} fill="#e6e9e4" />
    <rect width={W} height={H} filter={`url(#${uid}-grain)`} fill="#e6e9e4" />

    {/* repères de longitude, pour que la distance se lise */}
    {[60, 80, 100, 120].map((l) => (
      <>
        <line x1={px(l)} y1="4" x2={px(l)} y2={H - 4} stroke="#c3c8bf" stroke-width="0.25" stroke-dasharray="1 1.6" />
        <text x={px(l)} y={H - 1.2} class="grad" text-anchor="middle">{l}° E</text>
      </>
    ))}
    <line x1="4" y1={py(0)} x2={W - 4} y2={py(0)} stroke="#c3c8bf" stroke-width="0.3" />
    <text x="5" y={py(0) - 1} class="grad">équateur</text>

    {/* l'écart, sans figurer d'itinéraire */}
    <path d={`M ${px(MADA.lng) + 3} ${py(MADA.lat) - 1} Q ${px(80)} ${py(-16)} ${px(BORNEO[0].lng) - 3} ${py(BORNEO[0].lat) + 2}`}
          fill="none" stroke="#8a3a23" stroke-width="0.4" stroke-dasharray="2 1.5" opacity="0.75" />
    <text x={px(80)} y={py(-14.4)} class="dist" text-anchor="middle">environ 7 500 km</text>

    {BORNEO.map((l, i) => (
      <>
        <circle cx={px(l.lng)} cy={py(l.lat)} r={l.cible ? 1.5 : 1}
                fill={l.cible ? '#8a3a23' : 'none'} stroke="#8a3a23" stroke-width="0.4" />
        <text x={px(l.lng) + 2.4} y={py(l.lat) + (i - 1) * 3 + 0.8}
              class:list={['lg', l.cible && 'cible']}>{l.nom}</text>
      </>
    ))}
    {BORNEO[0].cible && (
      <circle cx={px(BORNEO[0].lng)} cy={py(BORNEO[0].lat)} r="3" fill="none"
              stroke="#8a3a23" stroke-width="0.3" opacity="0.6" />
    )}

    <circle cx={px(MADA.lng)} cy={py(MADA.lat)} r="1.5" fill="#8a3a23" stroke="#8a3a23" stroke-width="0.4" />
    <text x={px(MADA.lng) - 2.4} y={py(MADA.lat) + 0.8} class="lg cible" text-anchor="end">{MADA.nom}</text>

    <text x="4" y="2.8" class="titre">le sous-groupe barito du sud-est</text>
    <rect x="0.6" y="0.6" width={W - 1.2} height={H - 1.2} fill="none" stroke="#4a3c28" stroke-width="0.5" />
  </svg>
  <figcaption>
    <span class="quoi">
      Le malgache n'est pas seulement apparenté aux langues de Bornéo : la classification
      de référence le range dans le même petit sous-groupe qu'elles, celui du barito du
      sud-est, dont le ma'anyan est le membre le plus proche. Une seule branche, dont les
      rameaux se trouvent de part et d'autre de l'océan.
    </span>
    <span class="prov">
      Positions d'après Glottolog. Quatre autres langues du groupe ne sont pas dessinées,
      faute de coordonnées dans la source. Le trait ne figure aucun itinéraire : la route
      de la traversée est un point débattu, exposé plus haut sur cette page.
    </span>
  </figcaption>
</figure>

<style>
  .barito { margin: 2rem 0; }
  .barito svg { display: block; width: 100%; height: auto; }
  .titre { font-family: var(--sans); font-size: 2.6px; fill: #2b241a; font-weight: 600; }
  .lg { font-family: var(--sans); font-size: 2.3px; fill: #4a3c28; }
  .lg.cible { fill: #8a3a23; font-weight: 600; font-size: 2.6px; }
  .grad { font-family: var(--sans); font-size: 1.8px; fill: #8a8276; }
  .dist { font-family: var(--sans); font-size: 2px; fill: #8a3a23; font-style: italic; }
  figcaption { margin-top: .6rem; font-family: var(--sans); font-size: .78rem;
               line-height: 1.55; color: var(--ink-2);
               display: flex; flex-direction: column; gap: .15rem; }
  .quoi { color: var(--ink); }
  .prov { font-size: .72rem; opacity: .85; }
</style>
