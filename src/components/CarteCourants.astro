---
// Le partage du courant sud-équatorial sur la côte est de Madagascar.
//
// Statut de la figure, à ne pas confondre avec celui d'un claim : le trait de
// côte et la position des Comores sont réels, tirés du geojson du site et de
// coordonnées. Les flèches, elles, sont un SCHÉMA. Elles rendent la topologie
// décrite par geo-courants (arrivée par l'est, partage, branche nord qui se
// retourne vers le sud en longeant l'Afrique, branche sud) et non des vitesses
// mesurées ni des trajectoires relevées. La légende le dit.
//
// Pas de côte africaine : je n'ai pas son tracé, et l'esquisser à main levée
// serait la seule ligne inventée de la figure.
import brut from '../../public/madagascar.geojson?raw';

const contour: [number, number][] = JSON.parse(brut).features[0].geometry.coordinates[0];

// Boîte élargie au nord et à l'ouest pour tenir les Comores et l'entrée du canal.
const [x0, x1] = [41.8, 52.6];
const [y0, y1] = [-27.0, -10.4];
const W = 100;
const H = (W * (y1 - y0)) / (x1 - x0);
const px = (lng: number) => ((lng - x0) / (x1 - x0)) * W;
const py = (lat: number) => H - ((lat - y0) / (y1 - y0)) * H;

const ile = contour.map((p, i) => `${i ? 'L' : 'M'}${px(p[0]).toFixed(2)} ${py(p[1]).toFixed(2)}`).join(' ') + ' Z';

// Grande Comore, coordonnées réelles.
const comores = { x: px(43.25), y: py(-11.7) };

const P = (lng: number, lat: number) => `${px(lng).toFixed(2)} ${py(lat).toFixed(2)}`;
// Flèches schématiques : arrivée d'est, partage au large de la côte orientale,
// branche nord vers les Comores puis retour au sud, branche sud le long de la côte.
// Aucune de ces courbes ne doit passer sur la terre : un courant contourne
// l'île, il ne la traverse pas. Les points de contrôle sont donc tenus au large
// du trait de côte, et la branche nord double la pointe septentrionale.
const arrivee = `M${P(52.4, -15.3)} L${P(51.4, -15.4)}`;
const nord = `M${P(51.2, -15.0)} C${P(51.4, -12.6)} ${P(48.8, -10.6)} ${P(44.6, -11.7)}`;
const retour = `M${P(43.9, -12.9)} C${P(42.9, -16.0)} ${P(43.2, -19.0)} ${P(43.9, -21.8)}`;
const sud = `M${P(51.0, -16.2)} C${P(50.2, -19.0)} ${P(48.5, -23.5)} ${P(46.4, -26.1)}`;

const uid = 'cc';
---
<figure class="courants">
  <svg viewBox={`0 0 ${W} ${H.toFixed(2)}`} role="img"
       aria-label="Schéma du partage du courant sud-équatorial sur la côte est de Madagascar : arrivée par l'est, séparation en une branche nord qui passe aux Comores puis descend le canal, et une branche sud.">
    <defs>
      <filter id={`${uid}-grain`} x="0" y="0" width="100%" height="100%">
        <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="3" seed="11" result="n" />
        <feColorMatrix in="n" type="saturate" values="0" result="g" />
        <feComponentTransfer in="g" result="a"><feFuncA type="linear" slope="0.05" /></feComponentTransfer>
        <feComposite in="a" in2="SourceGraphic" operator="over" />
      </filter>
      <marker id={`${uid}-pointe`} viewBox="0 0 8 8" refX="6" refY="4"
              markerWidth="4.5" markerHeight="4.5" orient="auto-start-reverse">
        <path d="M0 0 L8 4 L0 8 z" fill="#2f6fb0" opacity="0.85" />
      </marker>
      <filter id={`${uid}-lavis`} x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="0.9" />
      </filter>
    </defs>

    <rect width={W} height={H} fill="#efe6d2" />
    <rect width={W} height={H} filter={`url(#${uid}-grain)`} fill="#efe6d2" />

    <g stroke="#a08a63" stroke-width="0.2" opacity="0.3">
      {[44, 46, 48, 50, 52].map((l) => <line x1={px(l)} y1="0" x2={px(l)} y2={H} />)}
      {[-12, -16, -20, -24].map((l) => <line x1="0" y1={py(l)} x2={W} y2={py(l)} />)}
    </g>

    <path d={ile} fill="none" stroke="#7d6a4a" stroke-width="2" opacity="0.4" filter={`url(#${uid}-lavis)`} />
    <path d={ile} fill="#f6efdd" stroke="#4a3c28" stroke-width="0.55" stroke-linejoin="round" />

    <g fill="none" stroke="#2f6fb0" stroke-width="0.75" stroke-linecap="round"
       opacity="0.85" marker-end={`url(#${uid}-pointe)`}>
      <path d={arrivee} /><path d={nord} /><path d={retour} /><path d={sud} />
    </g>

    <circle cx={comores.x} cy={comores.y} r="0.9" fill="#8a3a23" />
    <text x={comores.x} y={comores.y - 1.8} class="lieu" text-anchor="middle">Comores</text>
    <text x={px(52.4)} y={py(-17.2)} class="flux" text-anchor="end">courant sud-équatorial</text>
  </svg>
  <figcaption>
    <span class="quoi">
      Le courant arrive de l'est et se partage sur la côte de l'île : une branche vers le
      nord-ouest et les Comores, qui se retourne ensuite vers le sud dans le canal, une
      autre vers le sud le long de la côte orientale.
    </span>
    <span class="prov">
      Le trait de côte et la position des Comores sont réels. Les flèches sont un schéma :
      elles rendent la circulation décrite par
      <a href="https://doi.org/10.3389/fmars.2024.1402776" rel="noopener">Chenillat et coll. (2024)</a>,
      non des vitesses mesurées ni des trajectoires relevées.
    </span>
  </figcaption>
</figure>

<style>
  .courants { margin: 2rem 0; max-width: 460px; }
  .courants svg { display: block; width: 100%; height: auto;
                  border: 1px solid var(--rule); border-radius: 2px; }
  .lieu { font-family: var(--sans); font-size: 2.2px; fill: #6b5c44; }
  .flux { font-family: var(--sans); font-size: 2px; fill: #2f6fb0; opacity: .8; }
  figcaption { margin-top: .6rem; font-family: var(--sans); font-size: .78rem;
               line-height: 1.55; color: var(--ink-2);
               display: flex; flex-direction: column; gap: .15rem; }
  .quoi { color: var(--ink); }
  .prov { font-size: .72rem; opacity: .85; }
  .prov a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
</style>
