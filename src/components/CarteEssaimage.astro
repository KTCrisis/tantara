---
// L'essaimage maroseraña : quatre foyers, un sens, aucune frontière.
//
// La carte ne colorie pas des territoires, et ce n'est pas une économie de
// moyens. Personne ne sait où passaient les limites de ces monarchies, et le
// site refuse de les inventer ici comme ailleurs. Ce qu'elle montre est ce que
// la source établit : l'ordre des fondations, et leur remontée vers le nord.
//
// Provenance des quatre points, déclarée parce qu'elle n'est pas homogène.
// Le Menabe et le Boina reprennent les coordonnées portées par les assertions
// gh-sakalava-menabe et gh-sakalava-boina. Le Fiherena et le Nord-Ouest n'ont
// pas d'assertion située : ils sont posés sur la ville qui leur sert de repère,
// Toliara et Analalava. Un foyer marque donc une région, jamais une capitale ni
// une étendue.
//
// Le contour vient de public/madagascar.geojson, le graticule marque de vrais
// degrés. Même idiome que CarteRoyaumes, dont ce composant est le voisin.
import brut from '../../public/madagascar.geojson?raw';

const contour: [number, number][] = JSON.parse(brut).features[0].geometry.coordinates[0];

type Foyer = { nom: string; lat: number; lng: number; source: 'claim' | 'repere' };
const FOYERS: Foyer[] = [
  { nom: 'Fiherena', lat: -23.35, lng: 43.67, source: 'repere' },
  { nom: 'Menabe', lat: -20.3, lng: 44.3, source: 'claim' },
  { nom: 'Boina', lat: -15.85, lng: 46.0, source: 'claim' },
  { nom: 'Nord-Ouest', lat: -14.63, lng: 47.76, source: 'repere' },
];

const lngs = contour.map((p) => p[0]);
const lats = contour.map((p) => p[1]);
const [x0, x1] = [Math.min(...lngs) - 1.6, Math.max(...lngs) + 5.2];
const [y0, y1] = [Math.min(...lats) - 1.1, Math.max(...lats) + 1.1];
const W = 100;
const H = (W * (y1 - y0)) / (x1 - x0);
const px = (lng: number) => ((lng - x0) / (x1 - x0)) * W;
const py = (lat: number) => H - ((lat - y0) / (y1 - y0)) * H;

const trace = contour.map((p, i) => `${i ? 'L' : 'M'}${px(p[0]).toFixed(2)} ${py(p[1]).toFixed(2)}`).join(' ') + ' Z';

const meridiens: number[] = [];
for (let l = Math.ceil(x0); l <= Math.floor(x1); l += 2) meridiens.push(px(l));
const paralleles: number[] = [];
for (let l = Math.ceil(y0); l <= Math.floor(y1); l += 2) paralleles.push(py(l));

const pts = FOYERS.map((f) => ({ ...f, x: px(f.lng), y: py(f.lat) }));

// Les arcs bombent vers le canal, à l'ouest, puisque c'est la côte que ces
// monarchies longent. Ils disent un sens, pas un itinéraire suivi.
const arcs = pts.slice(0, -1).map((a, i) => {
  const b = pts[i + 1];
  const mx = (a.x + b.x) / 2 - 5.0;
  const my = (a.y + b.y) / 2;
  return `M${a.x.toFixed(2)} ${a.y.toFixed(2)} Q${mx.toFixed(2)} ${my.toFixed(2)} ${b.x.toFixed(2)} ${b.y.toFixed(2)}`;
});

const uid = 'ce';
---
<figure class="essaimage">
  <svg viewBox={`0 0 ${W} ${H.toFixed(2)}`} role="img"
       aria-label="Carte de Madagascar montrant quatre foyers sakalava du sud au nord, Fiherena, Menabe, Boina et Nord-Ouest, reliés par des arcs qui indiquent le sens de l'essaimage. Aucune frontière n'est tracée.">
    <defs>
      <filter id={`${uid}-grain`} x="0" y="0" width="100%" height="100%">
        <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="3" seed="7" result="n" />
        <feColorMatrix in="n" type="saturate" values="0" result="g" />
        <feComponentTransfer in="g" result="a"><feFuncA type="linear" slope="0.055" /></feComponentTransfer>
        <feComposite in="a" in2="SourceGraphic" operator="over" />
      </filter>
      <filter id={`${uid}-lavis`} x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="1.1" />
      </filter>
      <marker id={`${uid}-fleche`} viewBox="0 0 10 10" refX="8" refY="5"
              markerWidth="4" markerHeight="4" orient="auto-start-reverse">
        <path d="M0 1 L9 5 L0 9 z" fill="#8a3a23" opacity="0.75" />
      </marker>
    </defs>

    <rect width={W} height={H} fill="#efe6d2" />
    <rect width={W} height={H} filter={`url(#${uid}-grain)`} fill="#efe6d2" />

    <g stroke="#a08a63" stroke-width="0.25" opacity="0.35">
      {meridiens.map((x) => <line x1={x} y1="0" x2={x} y2={H} />)}
      {paralleles.map((y) => <line x1="0" y1={y} x2={W} y2={y} />)}
    </g>

    <path d={trace} fill="none" stroke="#7d6a4a" stroke-width="2.6" opacity="0.45" filter={`url(#${uid}-lavis)`} />
    <path d={trace} fill="#f6efdd" />
    <path d={trace} fill="none" stroke="#4a3c28" stroke-width="0.7" stroke-linejoin="round" />

    {arcs.map((d) => (
      <path d={d} fill="none" stroke="#8a3a23" stroke-width="0.55"
            stroke-dasharray="1.6 1.2" opacity="0.75" marker-end={`url(#${uid}-fleche)`} />
    ))}

    {pts.map((f, i) => (
      <g>
        <circle cx={f.x} cy={f.y} r="3.4" fill="#a8492f" opacity="0.14" />
        <circle cx={f.x} cy={f.y} r="1.15" fill="#8a3a23" opacity="0.9"
                stroke={f.source === 'repere' ? '#8a3a23' : 'none'}
                stroke-width="0.35" stroke-dasharray={f.source === 'repere' ? '0.7 0.5' : undefined}>
          <title>{f.nom}</title>
        </circle>
        {f.x > W * 0.66
          ? <text x={f.x - 2.6} y={f.y + 0.9} class="etiq" text-anchor="end">{i + 1}. {f.nom}</text>
          : <text x={f.x + 2.6} y={f.y + 0.9} class="etiq">{i + 1}. {f.nom}</text>}
      </g>
    ))}

    <rect x="1.2" y="1.2" width={W - 2.4} height={H - 2.4} fill="none" stroke="#4a3c28" stroke-width="0.7" />
    <rect x="2.6" y="2.6" width={W - 5.2} height={H - 5.2} fill="none" stroke="#4a3c28" stroke-width="0.3" />
  </svg>
  <figcaption>
    L'ordre des fondations et le sens de l'essaimage, du Fiherena au Nord-Ouest.
    Aucune frontière n'est tracée : personne ne sait où passaient les limites de ces
    monarchies. Les arcs indiquent une direction, pas un itinéraire suivi. Le Menabe et
    le Boina sont placés aux coordonnées portées par les assertions de cette page ; le
    Fiherena et le Nord-Ouest, qui n'en ont pas, sont posés sur la ville qui leur sert
    de repère, Toliara et Analalava, et leur point est cerclé de pointillés pour le dire.
  </figcaption>
</figure>

<style>
  .essaimage { margin: 2.2rem 0; }
  .essaimage svg { display: block; width: 100%; height: auto; border: 1px solid var(--rule); border-radius: 2px; }
  .etiq { font-family: var(--sans); font-size: 2.4px; fill: #4a3c28; }
  figcaption {
    margin-top: .6rem; font-family: var(--sans); font-size: .78rem;
    line-height: 1.55; color: var(--ink-2);
  }
</style>
