---
// Une planche est une image d'appui, jamais un document.
//
// Le site gradue ses assertions ; une image qui montre la position d'un
// continent au Jurassique en est une, et une image de style ancien peut se
// lire comme une pièce d'archive. La légende porte donc la même exigence
// qu'un claim : ce qu'on regarde, d'où vient la base, sous quelle licence,
// et ce qui a été retravaillé. L'aveu fait partie de la charte.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Ce que la planche montre. */
  legende: string;
  /** La base : auteur et publication d'origine. Absent si la planche est de synthèse. */
  source?: string;
  /** Licence de la base, telle qu'elle est déclarée à la source. */
  licence?: string;
  /**
   * Image de synthèse, sans base. Elle n'a ni auteur à créditer ni licence à
   * respecter, mais c'est justement celle qui doit le dire le plus clairement :
   * elle ne documente rien. Remplace source et licence.
   */
  synthese?: string;
  /** Ce qui a été fait à la base, et par qui. Omis si la base est servie telle quelle. */
  retouche?: string;
  /** Lien vers la base d'origine. */
  href?: string;
  /**
   * Où la planche se pose : dans la colonne, ou en marge avec le texte qui
   * l'enveloppe. Sur une page qui en porte plusieurs, alterner droite puis
   * gauche évite la colonne de vignettes empilées d'un seul côté. Le choix
   * reste explicite plutôt que calculé : une planche pleine largeur au milieu
   * casserait une alternance automatique sans que personne le voie.
   */
  cote?: 'pleine' | 'droite' | 'gauche';
}
const { src, alt, legende, source, licence, retouche, href, synthese, cote = 'pleine' } = Astro.props;
const enMarge = cote === 'droite' || cote === 'gauche';
// Largeurs rendues : la vignette suffit à la lecture, l'original reste servi
// pour l'agrandissement. Pas de visionneuse JS — un lien vers le fichier fait
// le même travail, fonctionne au clavier, et survit à un script bloqué.
const rendus = enMarge ? [320, 560, 760] : [480, 800, 1200];
const tailles = enMarge
  ? '(max-width: 720px) 100vw, 38vw'
  : '(max-width: 760px) 100vw, 712px';   // colonne .wrap : 760 moins 2 × 24 de marge
---
<figure class:list={['planche', enMarge && 'en-marge', cote === 'droite' && 'a-droite', cote === 'gauche' && 'a-gauche']}>
  <a href={src.src} class="loupe" title="Voir la planche en grand">
    <Image src={src} alt={alt} widths={rendus} sizes={tailles} />
  </a>
  <figcaption>
    <span class="quoi">{legende}</span>
    {/* Les faits restent sous l'image : sans eux la provenance n'est plus
        vérifiable d'un coup d'œil. C'est l'explication de la convention qui
        part, elle vit une seule fois sur /avertissement au lieu d'être
        recopiée sous chaque planche. */}
    <span class="prov">
      {synthese
        ? <a href="/avertissement#images">{synthese}</a>
        : <>{href ? <a href={href} rel="noopener">{source}</a> : source}, {licence}.
            {retouche && <> <a href="/avertissement#images">{retouche}</a></>}</>}
    </span>
  </figcaption>
</figure>

<style>
  .planche { margin: 2.2rem 0; max-width: 520px; }
  /* Hors marge, la planche est une figure à part entière : elle prend la largeur
     de la colonne, ses bords tombant sur ceux du texte. Alignée à gauche dans un
     cadre plus étroit, elle donnait une page décalée. */
  .planche:not(.en-marge) { max-width: 100%; margin-inline: auto; }
  /* En marge : le texte enveloppe la planche. Le float reste l'outil le plus
     sûr ici, une grille obligerait à découper la prose en colonnes, ce que le
     MDX ne permet pas sans casser le flux des assertions. */
  .planche.en-marge { width: 38%; max-width: 340px; }
  .planche.a-droite { float: right; margin: .4rem 0 1.2rem 1.8rem; }
  .planche.a-gauche { float: left;  margin: .4rem 1.8rem 1.2rem 0; }
  .planche :global(img) {
    display: block; width: 100%; height: auto;
    border: 1px solid var(--rule); border-radius: 2px; background: var(--paper-2);
    transition: box-shadow .15s ease;
  }
  .loupe { display: block; }
  .loupe:hover :global(img), .loupe:focus-visible :global(img) {
    box-shadow: 0 0 0 3px var(--paper), 0 0 0 4px var(--ocean);
  }
  figcaption {
    margin-top: .6rem; font-family: var(--sans); font-size: .78rem;
    line-height: 1.55; color: var(--ink-2);
    display: flex; flex-direction: column; gap: .15rem;
  }
  .planche.en-marge figcaption { font-size: .72rem; }
  .quoi { color: var(--ink); }
  /* La provenance se lit comme une note de bas de page : présente, discrète,
     jamais au même poids que la légende. Même geste que les marqueurs de
     statut en ligne dans la prose. */
  .prov { font-size: .72rem; color: var(--ink-2); opacity: .85; }
  .planche.en-marge .prov { font-size: .68rem; }
  .prov a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }

  /* Sous 720 px la colonne est trop étroite pour envelopper quoi que ce soit. */
  @media (max-width: 720px) {
    .planche.en-marge { float: none; width: auto; max-width: none; margin: 2rem 0; }
    .planche.en-marge figcaption, .planche.en-marge .prov { font-size: .78rem; }
  }
</style>
