---
import '@fontsource-variable/fraunces';
import '@fontsource/spectral/400.css';
import '@fontsource/spectral/400-italic.css';
import '@fontsource/spectral/500.css';
import '@fontsource/spectral/600.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Ornement from '../components/Ornement.astro';
import { clampMeta } from '../lib/meta';
interface Props { title: string; description?: string; }
// Le défaut n'est plus qu'un filet de sécurité : chaque page passe la sienne.
// Une description partagée par tout le site fait traiter les pages comme des
// doublons et pousse Google à élire sa propre canonique.
const { title, description = "L'état des preuves sur le peuplement et l'histoire de Madagascar." } = Astro.props;
// La borne est tenue ici, pas au jugé dans chaque page.
const meta = clampMeta(description);

const path = Astro.url.pathname.replace(/\/$/, '');
const canonical = new URL(path + '/', Astro.site ?? 'https://tantara.wiki');
const active = (href: string) => {
  const h = href === '/' ? '' : href;
  return path === h || (h !== '' && path.startsWith(h + '/')) ? 'active' : '';
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={meta} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
    <header class="mobile-bar">
      <a href="/" class="brand-m"><Ornement motif="marque" class="brand-mark" />tantara<em>.wiki</em></a>
      <label for="nav-toggle" class="nav-burger" aria-label="Ouvrir le menu"><span></span><span></span><span></span></label>
    </header>
    <label for="nav-toggle" class="nav-scrim" aria-hidden="true"></label>

    <aside class="sidebar">
      <a href="/" class="brand"><Ornement motif="marque" class="brand-mark" />tantara<em>.wiki</em></a>
      <nav>
        <a href="/" class={active('/')}>Accueil</a>
        <div class="nav-group">Le récit</div>
        <a href="/geographie" class={active('/geographie')}>Géographie</a>
        <a href="/megafaune" class={active('/megafaune')}>Le monde d'avant</a>
        <a href="/peuplement" class={active('/peuplement')}>Peuplement</a>
        <a href="/traditions-origines" class={active('/traditions-origines')}>Traditions &amp; origines</a>
        <a href="/geographie-historique" class={active('/geographie-historique')}>Géographie historique</a>
        <a href="/imerina" class={active('/imerina')}>L'Imerina</a>
        <div class="nav-group">Les acteurs</div>
        <a href="/peuples" class={active('/peuples')}>Les foko</a>
        <a href="/etats" class={active('/etats')}>Les États</a>
        <a href="/lieux" class={active('/lieux')}>Les lieux</a>
        <div class="nav-group">Lire les preuves</div>
        <a href="/methode" class={active('/methode')}>Méthode</a>
        <a href="/regards-exterieurs" class={active('/regards-exterieurs')}>Regards extérieurs</a>
        <a href="/sources" class={active('/sources')}>Sources</a>
      </nav>
    </aside>

    <div class="content">
      <main>
        <slot />
      </main>
      <footer class="site-foot">
        <Ornement motif="frise" class="foot-frise" />
        <div>tantara.wiki · l'histoire de Madagascar, par les preuves</div>
      </footer>
    </div>
  </body>
</html>
