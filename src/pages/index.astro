---
import Base from '../layouts/Base.astro';
import StatusBadge from '../components/StatusBadge.astro';
import ExploreMap from '../components/ExploreMap.astro';
import Planche from '../components/Planche.astro';
import Portes from '../components/Portes.astro';
import analakely from '../assets/planches/analakely.jpg';
import objets from '../assets/planches/objets-synthese.png';
import pGeographie from '../assets/portes/geographie.png';
import pMegafaune from '../assets/portes/megafaune.png';
import pPeuplement from '../assets/portes/peuplement.png';
import pFoko from '../assets/portes/foko.png';
import pLieux from '../assets/portes/lieux.png';
import { STATUTS } from '../content.config';

// Chaque vignette figure un objet qu'un collecteur du XIXe siècle à Madagascar
// aurait plausiblement monté sur une feuille de spécimen : l'anachronisme se
// verrait autant qu'une faute de date.
const portes = [
  { href: '/geographie', titre: 'Le commencement : la géographie', glose: 'le décor avant les hommes.',
    domain: 'geographie-physique', img: pGeographie,
    alt: "Feuille de spécimen : un fragment de roche volcanique poreuse sanglé au papier, à côté d'une palme séchée." },
  { href: '/megafaune', titre: "Le monde d'avant", glose: 'les géants disparus.',
    domain: 'faune-avant', img: pMegafaune,
    alt: "Planche ostéologique : le squelette monté d'un grand oiseau coureur, un œuf posé à ses pieds pour l'échelle." },
  { href: '/peuplement', titre: 'Le peuplement', glose: 'par la mer, en deux courants.',
    domain: 'peuplement', img: pPeuplement,
    alt: "Feuille de spécimen : un modèle réduit de pirogue à balancier, ses traverses ligaturées de fibre, et un épi de riz posé à côté." },
  { href: '/peuples', titre: 'Les dix-huit foko', glose: 'et pourquoi « dix-huit ».',
    kind: 'foko', img: pFoko,
    alt: "Feuille de spécimen : un fragment d'étoffe tissée à rayures, effrangé sur un bord." },
  { href: '/etats', titre: 'Les États', glose: 'royaumes côtiers et Imerina.',
    // Seule porte à ne rien inventer : la carte est tracée depuis le corpus.
    kind: 'royaume', carte: true },
  { href: '/lieux', titre: 'Les lieux', glose: 'des comptoirs morts aux capitales.',
    kind: 'lieu', img: pLieux,
    alt: "Planche : les ruines d'un petit fort côtier en pierre, deux canons démontés parmi les blocs, la mer derrière." },
];

const defs: Record<string, string> = {
  'mesuré': 'établi par la mesure : datations génétiques, archéobotanique.',
  'attesté': 'documenté par des sources écrites concordantes : archives, traités.',
  'reconstruit': 'inféré par méthode : linguistique historique, comparaison.',
  'daté-débattu': 'la communauté ne tranche pas : hypothèses concurrentes exposées.',
  'récit': 'tradition orale, tantara, mémoire, pas une preuve matérielle.',
  'conjectural': 'avancé, non établi : à prendre comme piste.',
};
---
<Base
  title="tantara.wiki — l'histoire de Madagascar, par les preuves"
  description="D'où viennent les Malgaches ? Une île peuplée tard, par deux courants venus de Bornéo et d'Afrique. Chaque assertion porte son statut de preuve et ses sources."
>
  <section class="hero">
    <div class="wrap">
      <div class="kicker">Madagascar · l'état des preuves</div>
      <h1>D'où viennent les Malgaches ?</h1>
      <p class="lead">
        De Bornéo et d'Afrique, et sur ce point les gènes sont nets : deux courants, un
        métissage datable, une trentaine de lignées maternelles fondatrices. Ce que l'on
        ignore est ailleurs : <strong>par quelle route ils sont venus, et pourquoi ils
        sont partis</strong>. Ce site pose l'un et l'autre à plat, chaque assertion
        portant son statut de preuve et ses sources.
      </p>
    </div>
  </section>

  <section class="wrap" id="aujourdhui">
    <h2>Aujourd'hui</h2>
    <Planche
      src={analakely}
      alt="Vue plongeante sur le marché d'Analakely à Antananarivo : les pavillons à toits de tuiles, l'avenue, et la ville qui monte à flanc de colline derrière."
      legende="Analakely, au centre d'Antananarivo. La ville monte à flanc de colline derrière les pavillons du marché."
      source="Cactus0625, Wikimedia Commons"
      licence="CC BY-SA 4.0"
      href="https://commons.wikimedia.org/wiki/File:Analakely_vu_d%27en_haut,_Madagascar.jpg"
      cote="droite"
    />
    <p>
      Madagascar compte près de 32 millions d'habitants, dont l'âge médian n'atteint
      pas vingt ans. Sa capitale, Antananarivo, en réunit environ trois millions.
      C'est aussi l'un des pays les plus pauvres du monde : près de quatre Malgaches
      sur cinq vivent sous le seuil d'extrême pauvreté.
    </p>
    <p>
      On range d'ordinaire la population en dix-huit <em>foko</em>, « ethnies » :
      Merina des Hautes Terres, Sakalava de l'Ouest, Betsileo, Betsimisaraka et les
      autres. Le découpage est commode et tardif, il doit beaucoup à l'administration
      coloniale, et les lignes qu'il trace pèsent encore. Les hiérarchies héritées,
      nobles, libres, descendants d'esclaves, ne se sont pas effacées, et la défiance
      entre Hautes Terres et côtes non plus.
    </p>
    <p>
      Ce site ne change rien à cela. Il rassemble ce que l'on sait de l'origine commune,
      preuves et doutes compris, et n'arbitre pas ce qui divise : une même île, peuplée
      par les mêmes traversées, et un état des preuves que chacun peut vérifier ligne à
      ligne.
    </p>
  </section>

  <section class="wrap">
    <h2>Ce que ce site rassemble</h2>
    <Planche
      src={objets}
      alt="Planche d'objets sur papier crème, dans un encadrement de rinceaux végétaux : deux coquillages, une roche volcanique poreuse, une palme séchée, un cristal de quartz et un rouleau de raphia."
      legende="Les matières par lesquelles on sait quelque chose de cette île : des coquillages, une roche volcanique, une palme, un cristal, du raphia. Aucun de ces objets n'a été trouvé quelque part."
      synthese="Image de synthèse produite par flux7.art. Elle n'illustre aucune pièce réelle et n'atteste de rien."
      cote="gauche"
    />
    <p>
      <em>Tantara</em> veut dire « histoire, récit » en malgache. Madagascar est le cas où
      la géographie semble tout expliquer : une île, un isolement de quatre-vingt-huit
      millions d'années, une arrivée tardive et par la mer, une faune qui n'existe nulle
      part ailleurs. Tout invite à dérouler la chaîne, du socle jusqu'aux royaumes.
    </p>
    <p>
      Ce site tente cette chaîne et s'arrête chaque fois qu'elle cesse d'être établie. Le
      relief explique qu'on ne pouvait venir que par la mer ; il n'explique ni qu'on soit
      venu si tard, ni que les ports aient changé de côté au XIX<sup>e</sup> siècle. C'est
      cette limite, plus que les faits, qui décide de ce qu'on lit ici.
    </p>
    <p>
      Le découpage en dix-huit <em>foko</em>, celui par lequel on décrit d'ordinaire les
      Malgaches, y est traité pour ce qu'il est : une construction tardive, et non une
      origine.
    </p>
  </section>

  <section class="wrap">
    <h2>Par où commencer</h2>
    <p>
      Chaque porte annonce son régime de preuve : la barre donne la composition des
      assertions rattachées, du mesuré au récit. La géographie est celle où la part du
      mesuré est la plus forte, un peu moins des deux tiers ; les États reposent d'abord
      sur la tradition dynastique.
    </p>
    <Portes portes={portes} />
    <p class="note-portes">
      Une assertion rattachée à plusieurs axes compte dans chacun : ces totaux ne
      s'additionnent donc pas au corpus. Les vignettes sont des images de synthèse,
      décoratives ; elles n'illustrent aucune pièce réelle.
    </p>
  </section>

  <section class="wrap">
    <h2>Explorer</h2>
    <p>
      La carte porte les <strong>foyers des foko</strong> en fond et les{' '}
      <strong>lieux</strong> en points. Chaque point ouvre le fil qui s'y rattache.
    </p>
    <ExploreMap />
  </section>

  <section class="wrap" id="methode">
    <h2>La méthode, en deux mots</h2>
    <p>
      Sur un sujet où le mesuré, le débattu et le mythifié se mélangent vite, chaque
      assertion porte deux étiquettes : la <strong>démarche</strong> (géologie, archéologie,
      génétique, linguistique, histoire) et le <strong>degré de certitude</strong>. Un point
      contesté n'est jamais arbitré : les hypothèses concurrentes sont montrées côte à côte.
    </p>
    <div class="legend-key" style="gap:10px;flex-wrap:wrap;">
      {STATUTS.map((s) => (<StatusBadge statut={s} />))}
    </div>
    <p style="margin-top:18px;">
      <a href="/methode"><strong>→ La méthode en entier : familles de preuve et état de la recherche</strong></a>
    </p>
  </section>

</Base>

<style>
  .note-portes {
    margin-top: 1rem; font-family: var(--sans); font-size: .76rem;
    line-height: 1.5; color: var(--ink-2);
  }
</style>
